environment {
    // Wayland backend preferences
    QT_QPA_PLATFORM "wayland"
    GDK_BACKEND "wayland"
    SDL_VIDEODRIVER "wayland"
    CLUTTER_BACKEND "wayland"

    // Firefox Wayland support
    MOZ_ENABLE_WAYLAND "1"

    // XDG Desktop Portal integration
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    XDG_SESSION_DESKTOP "niri"
    XDG_DATA_DIRS "/var/lib/flatpak/exports/share:$HOME/.local/share/flatpak/exports/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}:/usr/local/share:/usr/share"

    // Qt5/Qt6 theming
    //QT_QPA_PLATFORMTHEME "qt6ct"

    // Fix Java application rendering
    _JAVA_AWT_WM_NONREPARENTING "1"

    // Electron apps (VSCode, Cursor) - auto-detect best backend
    ELECTRON_OZONE_PLATFORM_HINT "auto"

    // Set default browser for xdg-open
    //BROWSER "firefox"
}
