# Configuración de Paquete: i3dots
# Este archivo es cargado por dots

# 1. Rutas y Directorios Base
export WALLPAPER_DIR="$HOME/wall"
export ROFI_THEME="$HOME/.config/rofi/themes/launcher.rasi"
export WALL_SEL_THEME="$HOME/.config/rofi/themes/WallSelect.rasi"

# Persistencia Local
export LAST_WALLPAPER_PATH_FILE="$HOME/.config/i3/wall"
export CURRENT_WALLPAPER_LINK="$HOME/.config/i3/current"

# Motor de wallpaper
export WP_ENGINE="live"

# Directorios de Lógica del Paquete
export HOOK_DIR="$PACKAGE_DIR/hooks"

# Configuración de Polybar
export POLYBAR_CONFIG_DIR="$HOME/.config/polybar"
export POLYBAR_LAUNCH_SCRIPT="$POLYBAR_CONFIG_DIR/launch.sh"

# Configuración de i3
export I3_CONFIG_DIR="$HOME/.config/i3"

# 2. Variantes y Componentes
if [ -f "$PACKAGE_DIR/.current_variant" ]; then
    VARIANT_NAME=$(cat "$PACKAGE_DIR/.current_variant")
    [ -f "$PACKAGE_DIR/distros/${VARIANT_NAME}/env" ] && source "$PACKAGE_DIR/distros/${VARIANT_NAME}/env"
fi
export SEQUENTIAL_COMPONENTS="icons"
export MANAGED_COMPONENTS="polybar i3 refresh"

# Mapeo de Componentes a archivos
export COMPONENT_POLYBAR="system.ini"
export COMPONENT_I3="config"
export COMPONENT_DISPLAY="resolution"
export COMPONENT_REFRESH="colors.conf"
export COMPONENT_ICONS="recolor_folders.lua"

# 3. Secuencias de Ejecución (DOT_SEQUENCES)
export DOT_SEQUENCE=(
    "wp_seq.sh"
)

export DOT_SEQUENCE_RELOAD=(
    "(polybar-msg cmd hide 2>/dev/null ; pkill -u $UID -x polybar) &"
    "engine_matugen.sh"
    "apply_dots.sh"
)

export DOT_SEQUENCE_DISPLAY=(
    "engine_display.sh"
)

export DOT_SEQUENCE_BAR=(
    "bar_menu.sh"
)

export DOT_SEQUENCE_WALLPAPER=(
    -c "wall_menu.sh"
)

export DOT_SEQUENCE_LIVE=(
    "wp_live_seq.sh"
)


# 4. Componentes Core (Rofi Selectors)
export WP_SEL_BIN="rofi"
export WP_SEL_ARGS="-dmenu -p Wallpaper -theme $WALL_SEL_THEME"
export WP_SEL_STYLE="-theme-str 'element-icon{size:450px;} element-text{horizontal-align:0.5;}'"
export WP_SEL_LINE_TMPL='%f\x00icon\x1f%p'
export WP_MANAGE_THEME="$HOME/.config/rofi/themes/wall_manage.rasi"

# UI Prompts para wall_menu.sh
export WP_PROM_THUMBS="Miniaturas en caché"
export WP_PROM_QUALITY="Calidad de Miniaturas"
export WP_PROM_NO_THUMB="Si falta miniatura"
export WP_PROM_BG_GEN="Pre-caché"
export WP_PROM_CLEAN="Limpiar Caché de Miniaturas"

export LAUNCHER_BIN="rofi"
export LAUNCHER_ARGS="-show drun -theme $HOME/.config/rofi/themes/launcher.rasi"

export POWERMENU_BIN="rofi"
export POWERMENU_ARGS="-theme $HOME/.config/rofi/themes/powermenu.rasi"
export POWERMENU_LABEL_SHUTDOWN="󰐥"
export POWERMENU_LABEL_REBOOT="󰑓"
export POWERMENU_LABEL_SUSPEND="󰖔"
export POWERMENU_LABEL_LOGOUT="󰿅"
export POWERMENU_CMD_LOGOUT="${POWERMENU_CMD_LOGOUT:-i3-msg exit}"
export POWERMENU_CMD_SHUTDOWN="${POWERMENU_CMD_SHUTDOWN:-systemctl poweroff}"
export POWERMENU_CMD_REBOOT="${POWERMENU_CMD_REBOOT:-systemctl reboot}"
export POWERMENU_CMD_SUSPEND="${POWERMENU_CMD_SUSPEND:-systemctl suspend}"


# 5. Configuración de Barra (Polybar)
export BAR_SEL_THEME="$HOME/.config/rofi/themes/shared/menu_generic.rasi"
export BAR_DEFAULT_TYPE="polybar_underline"
export BAR_STYLE="square"
export BAR_POSITION="bottom"
export BAR_TRANSPARENCY="false"
export BAR_HEIGHT="15pt"
export BAR_PRESETS="Pastillas: --type polybar_antigua | Flotante: --type polybar_floating --mode solid | Minimalista: --type polybar_underline --mode underline | Bloques: --type polybar_underline --mode solid | Compacto: --type polybar_compact"

# 6. Motor de Resolución (Engine Display)
export DISP_SEL_THEME="$HOME/.config/rofi/themes/shared/menu_generic.rasi"
export DISP_CONF_THEME="$HOME/.config/rofi/themes/display_confirm.rasi"
export DISP_SEL_BIN="rofi"
export DISP_SEL_ARGS="-dmenu -theme $DISP_SEL_THEME"
export DISP_CONF_ARGS="-dmenu -theme $DISP_CONF_THEME"
export DISP_INIT_POST_APPLY="false"
export DISP_GLYPH_MONITOR="󰍹 "
export DISP_GLYPH_RESOLUTION="󰘚 "
export DISP_GLYPH_RATE="󱎫 "
export DISP_GLYPH_SCALE="󰹯 "
export DISP_GLYPH_CONFIRM="󰗹 "
export DISP_SCALE_FILTER=""
export DISP_GLYPH_FILTER="󰃦 "
export DISP_SCALE_METHOD="scale"
export DISP_VAL_CUSTOM="personalizado"
export DISP_VAL_CUSTOM_SCALE="personalizada"
export DISP_UNIT_RATE=" Hz"
export DISP_VAL_CONFIRM="Confirmar"
export DISP_VAL_REVERT="Revertir"

# Prompts y Cadenas de UI
export DISP_PROM_MAIN="Configuración de Pantalla"
export DISP_PROM_TIMEOUT="Tiempo de Confirmación"
export DISP_PROM_MONITOR="Pantalla"
export DISP_PROM_RESOLUTION="Resolución"
export DISP_PROM_RATE="Frecuencia"
export DISP_PROM_SCALE="Escala"
export DISP_PROM_CONFIRM="¿Mantener resolución?"
export DISP_PROM_MSG="Se revertirá automáticamente tras %s segundos de inactividad."
export DISP_PROM_MENU_OUTPUT="1. Pantalla"
export DISP_PROM_MENU_RES="2. Resolución"
export DISP_PROM_MENU_RATE="3. Frecuencia"
export DISP_PROM_MENU_SCALE="4. Escala"
export DISP_PROM_MENU_ROTATION="5. Rotación"
export DISP_PROM_MENU_BRIGHTNESS="6. Brillo"
export DISP_PROM_MENU_FILTER="7. Nitidez (Filtro)"
export DISP_PROM_MENU_TIME="8. Tiempo Confirmación"
export DISP_PROM_MENU_APPLY="9. [ Aplicar y Probar ]"
export DISP_PROM_MENU_CANCEL="10. [ Cancelar y Salir ]"
export DISP_PROM_VAL_NONE="No seleccionada"
export DISP_PROM_VAL_AUTO="Auto"
export DISP_PROM_TIMES="5s\n10s\n15s\n30s\n60s"
export DISP_PROM_SCALES="0.5\n0.75\n1.0\n1.25\n1.5\n1.75\n2.0\n2.5\n3.0\npersonalizada"
export DISP_PROM_ROTATIONS="normal\nleft\nright\ninverted"
export DISP_PROM_BRIGHTNESSES="1.0\n0.9\n0.8\n0.7\n0.6\n0.5\npersonalizado"
export DISP_PROM_FILTERS="ninguno\nnearest\nbilinear"

# 7. Configuración de Live Wallpaper
# true: pausar video si hay cualquier ventana abierta (tiling)
# false: pausar video únicamente si la ventana está en pantalla completa (fullscreen)
export LIVE_WP_PAUSE_ON_WINDOW="true"
