* {
    background:     {{colors.surface.default.hex}}FF;
    background-alt: {{colors.surface_variant.default.hex}}FF;
    foreground:     {{colors.on_surface.default.hex}}FF;
    selected:       {{colors.primary.default.hex}}FF;
    selected-neutral: {{colors.on_surface.default.hex}}26;
    active:         {{colors.secondary.default.hex}}FF;
    urgent:         {{colors.error.default.hex}}FF;
    BG:             {{colors.surface.default.hex}}FF;
    BGA:            {{colors.surface_variant.default.hex}}FF;
    FG:             {{colors.on_surface.default.hex}}FF;
    SEL:            {{colors.primary.default.hex}}FF;
    BDR:            {{colors.outline.default.hex}}FF;
    ON:             {{colors.secondary.default.hex}}FF;
    OFF:            {{colors.error.default.hex}}FF;
    card-background: {{colors.on_surface.default.hex}}05;
    card-border:     {{colors.on_surface.default.hex}}0D;
    card-selected:   {{colors.on_surface.default.hex}}14;
}

element selected.normal {
    background-color: var(selected);
    text-color:       var(background);
}

element-text selected {
    text-color:       var(background);
}

element-icon selected {
    text-color:       var(background);
}
