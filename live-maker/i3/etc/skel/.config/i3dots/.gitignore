# Ignorar variante actual y estados locales
.current_variant
*.generated
*.log

# Directorio de persistencia de estado (Wallpaper activo, etc)
core/state/

# Enlaces simbólicos y archivos generados por Motores de Colores (Matugen/Hellwal)
packages/*/dotfiles/gtk-3.0/colors.css
packages/*/dotfiles/gtk-3.0/dank-colors.css
packages/*/dotfiles/gtk-4.0/colors.css
packages/*/dotfiles/gtk-4.0/dank-colors.css
packages/*/dotfiles/kitty/colors.conf
packages/*/dotfiles/matugen/wallpaper.txt
packages/*/dotfiles/qt6ct/colors/matugen.conf
packages/*/dotfiles/rofi/themes/shared/colors.rasi
packages/*/dotfiles/waybar/colors.css
packages/*/dotfiles/polybar_base/colors.ini
packages/*/dotfiles/polybar_base/user_configs.ini.bak
packages/*/dotfiles/i3/conf.d/vars.generated
packages/*/dotfiles/*/wall
packages/*/dotfiles/*/current

# Archivos del sistema y editores
.DS_Store
Thumbs.db
.ipynb_checkpoints/
*~
*.swp

# i3dots: Archivos dinámicos de colores (Matugen)
packages/i3dots/config/gtk-3.0/colors.css
packages/i3dots/config/gtk-3.0/bookmarks
packages/i3dots/config/gtk-4.0/colors.css
packages/i3dots/config/i3/*.generated
packages/i3dots/config/kitty/colors.conf
packages/i3dots/config/qt6ct/colors/matugen.conf
packages/i3dots/config/rofi/themes/shared/colors.rasi
packages/i3dots/config/i3/current
packages/i3dots/config/i3/current_static
packages/i3dots/config/i3/wall
packages/i3dots/config/dunst/dunstrc
packages/i3dots/config/qt6ct/qt6ct.conf
packages/i3dots/config/fastfetch/logo.txt
# i3dots: Configuración de hardware dinámica
packages/*/config/i3/conf.d/output.conf

# i3dots: Memoria privada del agente
.gemini/
memory/
MEMORY.md

# i3dots: Cache y estado local del script de iconos
packages/i3dots/config/i3/last_icon_color
packages/i3dots/config/i3/icon_theme.base

# Los bins precompilados están versionados en distros/*/bins/
# Los bins locales compilados en bin/ no se trackean
packages/i3dots/bin/xic
packages/i3dots/bin/polybar_autohide
packages/i3dots/bin/live_wp_daemon
