Notification {
    color: #F8F8F2;
    border: px solid rgba(98, 114, 164, 100%);
    background:rgba(40, 42, 54, 100%);
    margin: 0px;
    border-radius: 5px;
}

QLabel {
    color: #F8F8F2;
}

#closeButton {
    margin: 3px;
    border-radius: 4px;
    border: 1px solid transparent;
    padding: 4px;
    qproperty-icon: url(lxqt-notificationd/window-close.svg);
}

#closeButton:hover {
    color: rgba(54, 54, 54, 100%);
    background: rgba(68 71, 90, 30%);
    border: 1px solid rgba(98, 114, 164, 100%);
}

#appLabel {
    font-weight: bold;
}
