alias zshconfig="nvim ~/.zshrc"
alias update="paru -Syu && flatpak update"
alias cleaner="paru -c --noconfirm;  sudo paccache -rk1 --noconfirm; paru -Scc --noconfirm; paccache -r; rm -rf ~/.cache/thumbnails/*; trash-empty -f; gdu / 2>/dev/null"
alias gemini="agy"
alias cloude="agy"
alias cp="cp -iv"
alias mv="mv -iv"
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias playlist="yt-dlp -f bestaudio --extract-audio --audio-format mp3 --audio-quality 0 --embed-metadata --embed-thumbnail --cookies-from-browser firefox --limit-rate 5M -o '~/Music/%(title)s.%(ext)s'"
alias music="yt-dlp -f bestaudio --extract-audio --audio-format mp3 --audio-quality 0 --embed-metadata --embed-thumbnail --cookies-from-browser firefox --limit-rate 5M -o '~/Music/%(title)s.%(ext)s'"